# =========================================================================
# 3EBCHI STYLE 💈 — Variables d'environnement
# Copie ce fichier en ".env.local" (local) et renseigne les valeurs.
# Sur Vercel : Project Settings > Environment Variables.
# =========================================================================

# --- Supabase ---
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ SECRET — service role key. NE JAMAIS exposer au navigateur / committer.
# (Côté serveur uniquement.)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# --- Secret serveur ---
# Chaîne aléatoire longue (>= 32 caractères, obligatoire en production). Sert de
# clé HMAC pour les adresses du limiteur (aucune IP brute n'est stockée).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplace_par_une_chaine_aleatoire_longue

# --- Environnement des données (OBLIGATOIRE partout) ---
# Valeurs : production | preview | development | test
# - Sur Vercel : égal à l'environnement ("production" en Production, "preview"
#   en Preview, avec une base Supabase de preview SÉPARÉE).
# - En local : "development" (une base de dev, jamais celle de production).
# La base porte aussi sa propre étiquette (table public.app_environment, posée
# une fois dans le SQL Editor de CE projet). Si l'une ou l'autre ne correspond
# pas, le serveur refuse tout accès à la base. Voir docs/audits/PRODUCTION_READINESS.md.
DATA_ENVIRONMENT=development

# --- Espace hajem ---
# Hôtes où /barber répond (sinon 404). Liste séparée par des virgules.
# OBLIGATOIRE en production : un hôte servi par le déploiement de PRODUCTION
# (l'URL de la branche preview utilise désormais la base de preview).
# ADMIN_HOSTS=exemple-hote-de-production.vercel.app

# --- Seuils de sécurité (optionnels, voir lib/securityConfig.ts) ---
# LOGIN_ACCOUNT_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# SESSION_TTL_SECONDS=28800
# SESSION_IDLE_SECONDS=10800
# Limite anti-abus : 6 réservations par adresse réseau par 10 min (partagée).
# BOOKING_IP_MAX=6
# BOOKING_IP_WINDOW_SECONDS=600
# Plafond de réservations à venir par numéro : 0 = désactivé (défaut).
# BOOKING_MAX_ACTIVE_PER_PHONE=0

# --- Notifications push du dashboard hajem (gratuites, optionnelles) ---
# Génère la paire avec :  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# ⚠️ SECRET — ne jamais committer.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.com

# -------------------------------------------------------------------------
# NOTE : les mots de passe des barbiers ne sont PAS ici.
# Ils sont hachés (scrypt) et stockés dans la table `barbers` en BDD.
# Voir README.md -> "Mot de passe des barbiers" et `npm run set-password -- <id>`.
# -------------------------------------------------------------------------
